# Defines whether to use same session for all users
USE_DEFAULT_SESSION=false

# Basis Theory API Key
BASIS_THEORY_API_KEY=your_basis_theory_api_key_here

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Adyen Configuration
ADYEN_API_KEY=your_adyen_api_key_here
ADYEN_MERCHANT_ACCOUNT=your_adyen_merchant_account_here

# Braintree Configuration
BRAINTREE_MERCHANT_ID=your_braintree_merchant_id_here
BRAINTREE_PUBLIC_KEY=your_braintree_public_key_here
BRAINTREE_PRIVATE_KEY=your_braintree_private_key_here

# TabaPay Configuration
TABAPAY_CLIENT_TOKEN=your_tabapay_client_token_here
TABAPAY_AUTH_TOKEN=your_tabapay_auth_token_here

# Chase Orbital Configuration
CHASE_ORBITAL_USERNAME=your_chase_orbital_username_here
CHASE_ORBITAL_PASSWORD=your_chase_orbital_password_here
CHASE_ORBITAL_MERCHANT_ID=your_chase_orbital_merchant_id_here

# Checkout Configuration
CHECKOUT_SECRET_KEY=your_checkout_secret_key_here
CHECKOUT_PUBLIC_KEY=your_checkout_public_key_here